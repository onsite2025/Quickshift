# Firebase Web (client)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server) — service account from Firebase console
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Optional but strongly recommended once 10DLC is approved. Routes outbound
# messages through your Messaging Service so the campaign + sender pool apply.
# Find this on Messaging -> Services -> click the service -> SID (starts with MG).
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_VALIDATE_SIGNATURE=true

# Anthropic (Claude) — used to parse inbound facility shift requests
ANTHROPIC_API_KEY=

# Public app URL (Vercel deployment URL or your custom domain)
NEXT_PUBLIC_APP_URL=

# Vercel KV (optional). When set, portal endpoints use KV-backed rate limiting
# instead of in-memory. Create a KV store in the Vercel dashboard and connect
# it to this project — Vercel auto-injects these env vars.
KV_REST_API_URL=
KV_REST_API_TOKEN=
