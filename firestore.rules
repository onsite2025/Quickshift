rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // role is a custom claim minted by /api/auth/init.
    function isOperator() {
      return isSignedIn() && request.auth.token.role == "operator";
    }

    // Server (admin SDK) bypasses these rules entirely. Web-SDK clients
    // hit them as a "must be operator" gate for everything operational.

    match /users/{uid} {
      // Self-read so the AuthProvider can show the current user their role.
      allow get: if isSignedIn() && request.auth.uid == uid;
      // Only operators can list / change roles.
      allow list, update: if isOperator();
      // user docs are created server-side by /api/auth/init.
      allow create, delete: if false;
    }

    match /nurses/{nurseId} {
      allow read, write: if isOperator();
    }

    match /facilities/{facilityId} {
      allow read, write: if isOperator();
    }

    match /shifts/{shiftId} {
      allow read, write: if isOperator();
    }

    match /documents/{documentId} {
      allow read, write: if isOperator();
    }

    match /timesheets/{timesheetId} {
      allow read, write: if isOperator();
    }

    match /invoices/{invoiceId} {
      allow read, write: if isOperator();
    }

    match /messages/{messageId} {
      allow read, create: if isOperator();
      allow update, delete: if isOperator();
    }

    // SMS audit log — written server-side only; readable by operators.
    match /smsLogs/{logId} {
      allow read: if isOperator();
      allow write: if false;
    }
  }
}
